# FastGPT 定制镜像自动构建与发布：
# security-agent-dev 分支出现新提交（GitHub → Gitea 镜像同步 ≤10 分钟）即自动构建并部署到发布服务器。
# 也可在 Gitea 页面手动触发（workflow_dispatch）。
name: build-deploy-fastgpt-image
on:
  push:
    branches: [security-agent-dev]
  workflow_dispatch:

concurrency:
  group: release-deploy
  cancel-in-progress: false

env:
  RELEASE_HOST: 10.10.31.33
  RELEASE_USER: liuyubo
  RELEASE_DIR: Security-agent

jobs:
  build-deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: 构建 fastgpt 镜像（20-40 分钟）
        run: |
          TAG=$(echo "${{ github.sha }}" | cut -c1-8)
          echo "TAG=$TAG" >> "$GITHUB_ENV"
          docker build -f projects/app/Dockerfile -t "fastgpt:$TAG" . --build-arg proxy=cn

      - name: 配置发布服务器 SSH
        run: |
          mkdir -p ~/.ssh && chmod 700 ~/.ssh
          echo "${{ secrets.RELEASE_SSH_KEY }}" > ~/.ssh/id_ed25519
          chmod 600 ~/.ssh/id_ed25519
          ssh-keyscan -H "$RELEASE_HOST" >> ~/.ssh/known_hosts 2>/dev/null

      - name: 传输镜像到发布服务器
        run: |
          TAG=$(echo "${{ github.sha }}" | cut -c1-8)
          docker save "fastgpt:$TAG" | gzip -1 | ssh "$RELEASE_USER@$RELEASE_HOST" 'gunzip | docker load'

      - name: 发布服务器滚动更新 fastgpt-app
        env:
          RELEASE_MIRROR_URL: ${{ secrets.RELEASE_MIRROR_URL }}
        run: |
          TAG=$(echo "${{ github.sha }}" | cut -c1-8)
          ssh "$RELEASE_USER@$RELEASE_HOST" "
            set -e
            docker tag fastgpt:$TAG fastgpt:security-agent
            # 全新服务器自举：主仓库 / 嵌套仓库（即本仓库）不存在时从 Gitea 镜像克隆
            if [ ! -d ~/$RELEASE_DIR/.git ]; then
              git clone $RELEASE_MIRROR_URL/Security-agent.git ~/$RELEASE_DIR
              mkdir -p ~/$RELEASE_DIR/third_party
            fi
            if [ ! -d ~/$RELEASE_DIR/third_party/FastGPT/.git ]; then
              git clone -b security-agent-dev $RELEASE_MIRROR_URL/FastGPT-Security-agent.git ~/$RELEASE_DIR/third_party/FastGPT
            fi
            cd ~/$RELEASE_DIR
            git -C third_party/FastGPT fetch origin security-agent-dev || true
            git -C third_party/FastGPT reset --hard ${{ github.sha }} || true
            if [ ! -f config/.env ]; then
              echo '[fastgpt-image] config/.env 不存在（全新服务器）：镜像已就绪，滚动更新推迟到 provision 同步配置后'
              exit 0
            fi
            docker compose --env-file config/.env \
              -f docker/docker-compose.yml -f docker/docker-compose.override.yml \
              -p fastgpt up -d fastgpt-app
            sleep 15
            code=\$(curl -s -o /dev/null -w '%{http_code}' --connect-timeout 10 http://10.10.31.33:3000 || true)
            echo \"FastGPT health -> \$code\"
          "
